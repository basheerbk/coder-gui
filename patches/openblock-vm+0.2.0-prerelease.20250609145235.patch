@@ -946,6 +946,54 @@ class OpenBlockArduinoUnoDevice {
         this._peripheral.setServoOutput(args.PIN, args.OUT);
         return Promise.resolve();
     }
+
+    /**
+     * Upload-mode-only blocks: used for codegen, not realtime VM execution.
+     * Stubs silence registration warnings when methods are missing.
+     */
+    attachInterrupt () {
+        return Promise.resolve();
+    }
+    detachInterrupt () {
+        return Promise.resolve();
+    }
+    serialBegin () {
+        return Promise.resolve();
+    }
+    serialPrint () {
+        return Promise.resolve();
+    }
+    serialAvailable () {
+        return Promise.resolve(0);
+    }
+    serialReadAByte () {
+        return Promise.resolve(0);
+    }
+    dataMap (args) {
+        const value = Number(args.DATA);
+        const fromLow = Number(args.ARG0);
+        const fromHigh = Number(args.ARG1);
+        const toLow = Number(args.ARG2);
+        const toHigh = Number(args.ARG3);
+        if (fromHigh === fromLow) return toLow;
+        return (value - fromLow) * (toHigh - toLow) / (fromHigh - fromLow) + toLow;
+    }
+    dataConstrain (args) {
+        const value = Number(args.DATA);
+        const min = Number(args.ARG0);
+        const max = Number(args.ARG1);
+        return Math.min(Math.max(value, min), max);
+    }
+    dataConvert (args) {
+        return args.DATA;
+    }
+    dataConvertASCIICharacter (args) {
+        return String.fromCharCode(Number(args.DATA) || 0);
+    }
+    dataConvertASCIINumber (args) {
+        const text = String(args.DATA || '');
+        return text.length ? text.charCodeAt(0) : 0;
+    }
 }
 
 module.exports = OpenBlockArduinoUnoDevice;
