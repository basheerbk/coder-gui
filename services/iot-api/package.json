{
  "name": "tinkerbit-iot-api",
  "version": "1.0.0",
  "private": true,
  "description": "TinkerBit Cloud: MQTT ingest, device management and dashboard API.",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.mjs\"",
