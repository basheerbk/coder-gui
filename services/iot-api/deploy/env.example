# /etc/tinkerbit-iot/env  (root:tinkerbit-iot, mode 0640)
# install-on-ec2.sh generates the MQTT passwords; AUTH_SECRET must be pasted in.

NODE_ENV=production

# Must be identical to AUTH_SECRET on Vercel (it verifies the tb_session cookie).
AUTH_SECRET=

# Comma-separated pilot emails, or * to open to every signed-in user.
# Empty = nobody (fail closed).
IOT_ALLOWLIST=

IOT_ENABLED=1
IOT_HOST=127.0.0.1
IOT_PORT=20114
IOT_DB_PATH=/var/lib/tinkerbit-iot/iot.db
IOT_ALLOWED_ORIGINS=https://www.tinkerbit.io,https://tinkerbit.io

IOT_BROKER_MODE=mosquitto
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_INGEST_USER=tb-ingest
MQTT_INGEST_PASS=
MQTT_ADMIN_USER=tb-admin
MQTT_ADMIN_PASS=

IOT_PUBLIC_HOST=api.tinkerbit.io
IOT_PUBLIC_MQTTS_PORT=8883
IOT_PUBLIC_WSS_PATH=/mqtt
IOT_LIVE_URL=wss://api.tinkerbit.io/iot/v1/live

# Pilot limits (defaults shown)
IOT_MAX_DEVICES_PER_USER=10
IOT_MAX_CREATES_PER_DAY=10
IOT_MIN_INTERVAL_SEC=5
IOT_DEFAULT_INTERVAL_SEC=10
IOT_USER_RPM=120
IOT_LIVE_SOCKETS_PER_USER=5
IOT_OFFLINE_GRACE_SEC=60

# Backups (tinkerbit-iot-backup.timer). S3 upload uses the EC2 instance role.
IOT_BACKUP_DIR=/var/backups/tinkerbit-iot
IOT_BACKUP_S3_URI=
IOT_BACKUP_KEEP_LOCAL=7
IOT_BACKUP_EXTRA_FILES=/var/lib/mosquitto/dynamic-security.json,/var/lib/mosquitto/mosquitto.db
