# Google OAuth (Web application client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32+ character random secret used to sign session cookies
AUTH_SECRET=

# Public site origin (no trailing slash)
# Production: https://www.tinkerbit.io
# Local vercel dev: http://127.0.0.1:3000
AUTH_BASE_URL=https://www.tinkerbit.io

# Local only: set to 1 to skip Google login outside Vercel production
# AUTH_DISABLED=1
